Q.438 --> Find all anagram in a string.
// java optimal solution

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        
        List<Integer> ans=new ArrayList<>();
        if(s.length()<p.length()) return ans;
        int[] freq=new int[26];
        for(char ch:p.toCharArray()){
            freq[ch-'a']++;
        }
        int[] window=new int[26];
        int k=p.length();
        for(int i=0;i<k;i++){
            window[s.charAt(i)-'a']++;
        }
        for(int i=k;i<s.length();i++){
            if(Arrays.equals(freq,window)) ans.add(i-k);
            window[s.charAt(i)-'a']++;
            window[s.charAt(i-k)-'a']--;
        }
        if(Arrays.equals(freq,window)){
            ans.add(s.length()-k);
        }
        return ans;
    }
}
