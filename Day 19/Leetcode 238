Q.238 --> Product of array except self.
//java solution by prefix and suffix multplication

class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n=nums.length;
        int[] ans=new int[n];
        int[] pre=new int[n];
        int product=1;
        pre[0]=1;
        for(int i=1;i<n;i++){ 
            product*=nums[i-1];
            pre[i]=product;
        }
        int right=1;

        for(int i=n-1;i>=0;i--){
            ans[i]=pre[i]*right;
            right*=nums[i];
        }
        return ans;
    }
}
