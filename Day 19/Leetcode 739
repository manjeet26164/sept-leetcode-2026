Q.739 --> Daily tempreatures.
//java soltuion by monotonic stack

class Solution {
    public int[] dailyTemperatures(int[] temp) {
        int n=temp.length;
        Stack<Integer> st=new Stack<>();
        int[] ans=new int[n];
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && temp[i]>temp[st.peek()]){
                int top=st.pop();
                ans[top]=i-top;
            }
            st.push(i);
        }
        return ans;
    }
}
