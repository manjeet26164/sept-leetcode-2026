// Q.1514  -> Path with maximum probability.
// java solution (Dijkstra's algo)

class Solution {
    public class Pair implements Comparable<Pair>{
        int node;
        double prob;
        public Pair(int node, double prob){
            this.node=node;
            this.prob=prob;
        }
        public int compareTo(Pair p){
            return Double.compare(p.prob,this.prob);
        }
    }
    public double maxProbability(int n, int[][] edges, double[] succProb, int start_node, int end_node) {
        List<List<Pair>> adj=new ArrayList<>();
        for(int i=0;i<n;i++){
            adj.add(new ArrayList<>());
        }
        for(int i=0;i<edges.length;i++){
            int a=edges[i][0];
            int b=edges[i][1];
            double probability=succProb[i];
            adj.get(a).add(new Pair(b,probability));
            adj.get(b).add(new Pair(a,probability));
        }
        double[] maxProb=new double[n];
        maxProb[start_node]=1.0;
        PriorityQueue<Pair> pq=new PriorityQueue<>();
        pq.add(new Pair(start_node,1.0));
        while(!pq.isEmpty()){
            Pair top=pq.remove();
            int node=top.node;
            double prob=top.prob;
            if(prob<maxProb[node]) continue;
            for(Pair ele: adj.get(node)){
                double totalProb= prob*ele.prob;
                if(totalProb>maxProb[ele.node]){
                    maxProb[ele.node]=totalProb;
                    pq.add(new Pair(ele.node,totalProb));
                }
            }
        }
        return maxProb[end_node];
    }
}
