// Q.787 --> Cheapest flight with k stops 
// java soltion 

// Method 1 with Dijkstra's algo
// But the problem with this algo is, this will run the test cases that are given on the question but when we submit it will show as a wrong ans.
// Code

class Solution {
    public class Pair{
        int node;
        int price;
        public Pair(int node, int price){
            this.node=node;
            this.price=price;
        }
    }
    public class Triplet implements Comparable<Triplet>{
        int node;
        int price;
        int stop;
        public Triplet(int node, int price, int stop){
            this.node=node;
            this.price=price;
            this.stop=stop;
        }
        public int compareTo(Triplet t){
            return this.price-t.price;
        }
    }
    public int findCheapestPrice(int n, int[][] flights, int src, int dst, int k) {
        List<List<Pair>> adj=new ArrayList<>();
        for(int i=0;i<n;i++){
            adj.add(new ArrayList<>());
        }
        for(int i=0;i<flights.length;i++){
            int a=flights[i][0];
            int b=flights[i][1];
            int price=flights[i][2];
            adj.get(a).add(new Pair(b,price));
        }
        PriorityQueue<Triplet> pq=new PriorityQueue<>();
        pq.add(new Triplet(src,0,0));
        int[] ans=new int[n];
        Arrays.fill(ans,Integer.MAX_VALUE);
        ans[src]=0;
        while(!pq.isEmpty()){
            Triplet top=pq.remove();
            int node=top.node;
            int cost=top.price;
            int stop=top.stop;
            if(stop==k+1) continue;
            for(Pair ele:adj.get(node)){               
                int totalCost=cost+ele.price;
                if(totalCost<ans[ele.node]){
                    ans[ele.node]=totalCost;
                    pq.add(new Triplet(ele.node,totalCost,stop+1));
                }
            }
        }
        return ans[dst] == Integer.MAX_VALUE ? -1: ans[dst];
        
    }
}



